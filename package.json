{
  "name": "mrs-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "npx prisma db push && node dist/main.js",
    "start:dev": "npx prisma db push && ts-node-dev --respawn --transpile-only src/main.ts",
    "db:setup": "prisma db push",
    "db:migrate": "prisma db push",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "node dist/docs/swagger.js",
    "prisma:generate": "prisma generate",
    "migrate": "ts-node src/migrations/migrate.ts",
    "migrate:dist": "node dist/migrations/migrate.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/cqrs": "^10.2.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express-mongo-sanitize": "^2.2.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "nestjs-pino": "^3.5.0",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.0.0",
    "pino-http": "^8.0.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0"
  },
  "overrides": {
    "@nestjs/common": "$@nestjs/common",
    "@nestjs/core": "$@nestjs/core",
    "@nestjs/platform-express": "$@nestjs/platform-express",
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
